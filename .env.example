# Discord bot token
DISCORD_BOT_TOKEN=your-discord-bot-token

# Ollama configuration
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional: full system prompt template for Ollama.
# Available placeholders: {bot_name}, {guild_name}, {channel_name}, {user_name}
BOT_SYSTEM_PROMPT=
BOT_HISTORY_MAX_TURNS=12

# Optional: text channel for commands, transcripts, and replies
BOT_TEXT_CHANNEL_ID=

# Optional: voice channel for join/talk features
BOT_VOICE_CHANNEL_ID=

# Optional: reaction control for voice loop on a pinned message
BOT_REACTION_MESSAGE_ID=
BOT_REACTION_EMOJI=🎙️
BOT_REACTION_RECORD_SECONDS=600
BOT_REACTION_STOP_DELAY_MS=750

# Optional: hands-free auto-listen tuning after the bot joins voice
BOT_AUTO_LISTEN_SILENCE_SECONDS=1.5
BOT_AUTO_LISTEN_PHRASE_LIMIT_SECONDS=30
BOT_AUTO_LISTEN_MIN_DISTINCT_WORDS=3
BOT_AUTO_LISTEN_MIN_AUDIO_SECONDS=0.9
BOT_AUTO_LISTEN_VOICED_WINDOW_RMS=900
BOT_AUTO_LISTEN_MIN_VOICED_WINDOWS=8

# Optional: save each exchange to a JSON file
ENABLE_CONVERSATION_LOGGING=false
CONVERSATION_LOG_PATH=conversations

# Optional: speech recognition configuration
RECORDINGS_DIR=recordings
WHISPER_MODEL=base.en
WHISPER_AUDIO_GAIN=1.15
WHISPER_TARGET_RMS=14000
WHISPER_MAX_GAIN=6.0
WHISPER_BEAM_SIZE=1

# Optional: where generated TTS audio files are written briefly before playback
TTS_AUDIO_DIR=generated_audio

# Optional: runtime log file or directory
RUNTIME_LOG_PATH=logs
